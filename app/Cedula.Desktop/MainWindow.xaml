<Window x:Class="Cedula.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cédula Reader — Portable" Width="1600" Height="1000" MinWidth="1200" MinHeight="800" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#F4F6F2" FontFamily="{DynamicResource AppFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Grid x:Name="Viewport" SizeChanged="ViewportSizeChanged">
<DockPanel x:Name="Workspace" Margin="24">
 <DockPanel.LayoutTransform><ScaleTransform x:Name="WorkspaceScale"/></DockPanel.LayoutTransform>
 <StackPanel DockPanel.Dock="Top">
  <TextBlock Text="CÉDULA / READER" FontSize="26" FontWeight="SemiBold" Foreground="#12332F"/>
  <TextBlock Text="Portable document workspace · Original bytes preserved locally" Foreground="#61716B" Margin="0,5,0,20"/>
  <WrapPanel Margin="0,0,0,12">
   <Button x:Name="NewButton" Content="+ New profile" Click="NewProfile"/>
   <ComboBox x:Name="Readers" Width="245" Padding="8" Margin="0,0,8,0" ToolTip="Selected NFC reader"/>
   <Button Content="Refresh reader" Click="RefreshReader"/>
   <TextBlock Text="CAN" VerticalAlignment="Center" Margin="5,0,8,0"/>
   <PasswordBox x:Name="Can" Width="100" MaxLength="6" Padding="8" Margin="0,0,8,0" ToolTip="Six-digit card access number"/>
   <Button x:Name="ReadButton" Content="Read cédula" Click="ReadCard" Background="#0E6B63" Foreground="White"/>
   <Button x:Name="CancelButton" Content="Cancel" Click="CancelRead" IsEnabled="False"/>
  </WrapPanel>
  <WrapPanel Margin="0,0,0,15">
   <Button x:Name="ImportButton" Content="Import recorded scan" Click="ImportRecorded"/>
   <Button Content="Restore ZIP" Click="RestoreZip"/>
   <Button Content="Open data folder" Click="OpenData"/>
   <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#61716B" Text="Ready · No card operation until Read cédula" TextWrapping="Wrap"/>
  </WrapPanel>
 </StackPanel>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0">
   <TextBox x:Name="Search" DockPanel.Dock="Top" TextChanged="SearchChanged" ToolTip="Search name or document number" Margin="0,0,0,12"/>
   <TextBlock DockPanel.Dock="Top" Text="PROFILES / SCAN HISTORY" FontSize="11" Foreground="#61716B" Margin="0,0,0,12"/>
   <ListBox x:Name="Profiles" SelectionChanged="ProfileSelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,10" MaxWidth="225"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Document}" Foreground="#61716B"/><TextBlock Text="{Binding Time, StringFormat=yyyy-MM-dd HH:mm}" FontSize="11"/><TextBlock Text="{Binding Mode}" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
     <TextBlock x:Name="PersonName" Text="New profile" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="Subtitle" Text="Place a cédula on the reader and enter its CAN." Foreground="#61716B" Margin="0,5" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,10,0,0"><Button Content="Export scan ZIP" Click="ExportScan"/><Button Content="Export profile history" Click="ExportHistory"/><Button Content="Delete profile" Click="DeleteProfile"/></WrapPanel>
    </StackPanel>
    <TabControl x:Name="Tabs" BorderThickness="0">
     <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="#F0F3EF" CornerRadius="8" Padding="8"><Image x:Name="Portrait" Height="210" Stretch="Uniform"/></Border>
       <StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock x:Name="Summary" Text="No scan loaded" TextWrapping="Wrap"/><TextBlock Text="Handwritten signature" Margin="0,20,0,8" Foreground="#61716B"/><Image x:Name="Signature" Height="95" Stretch="Uniform" HorizontalAlignment="Left"/></StackPanel>
      </Grid>
      <Border x:Name="Rsa1024Notice" Visibility="Collapsed" Background="#FFF4F2" BorderBrush="#F3B5AF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
       <StackPanel>
        <TextBlock Text="RSA-1024 detected · obsolete key size" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <DataGrid x:Name="Rsa1024Timeline" AutoGenerateColumns="False" Background="Transparent" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False" IsTabStop="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
         <DataGrid.Resources>
          <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6"/></Style>
         </DataGrid.Resources>
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="Organization" Width="1.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
           <TextBlock TextWrapping="Wrap" Margin="6"><Hyperlink Foreground="#0E6B63" NavigateUri="{Binding Source}" RequestNavigate="OpenStandardSource"><Run Text="{Binding Organization}"/></Hyperlink></TextBlock>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Year" Width="0.55*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Year}" TextWrapping="Wrap" Margin="6" Foreground="#173C35"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Scope / milestone" Width="1.8*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Margin="6" Foreground="#173C35"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Dates apply to different uses; they do not establish a Dominican card-policy violation. Select an organization to view its source (internet required)." Foreground="#61716B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock x:Name="Warnings" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"/>
      <TextBlock x:Name="ScanError" TextWrapping="Wrap" Foreground="#9A4D00" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Identity"><DataGrid x:Name="IdentityGrid"/></TabItem>
     <TabItem Header="Images"><ScrollViewer><StackPanel><Image x:Name="LargePortrait" MaxHeight="500" Margin="12"/><Image x:Name="LargeSignature" MaxHeight="300" Margin="12"/></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Certificates &amp; keys"><Grid><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ListBox x:Name="KeyList" SelectionChanged="KeySelected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="#B42318" FontWeight="Bold" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBox x:Name="KeyDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource AppMono}" FontSize="12"/>
     </Grid></TabItem>
     <TabItem Header="Inventory"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions><DataGrid x:Name="InventoryGrid" SelectionChanged="ObjectSelected"/><TextBox x:Name="ObjectDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource AppMono}" FontSize="12"/></Grid></TabItem>
     <TabItem Header="Verification"><DataGrid x:Name="ChecksGrid"/></TabItem>
    </TabControl>
   </DockPanel>
  </Border>
 </Grid>
</DockPanel>
</Grid>
</Window>
