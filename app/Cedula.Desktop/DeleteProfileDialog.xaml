<Window x:Class="Cedula.Desktop.DeleteProfileDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Delete profile" Width="760" Height="460" MinWidth="560" MinHeight="360"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
 Background="#F5F8F6" Foreground="#173C35" FontFamily="{DynamicResource AppFont}" FontSize="18">
 <Grid x:Name="Viewport" SizeChanged="ViewportSizeChanged">
  <Grid Margin="28">
   <Grid.LayoutTransform><ScaleTransform x:Name="ContentScale"/></Grid.LayoutTransform>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="Delete this profile?" FontSize="28" FontWeight="SemiBold" Foreground="#A32323" TextWrapping="Wrap"/>
     <TextBlock Margin="0,20,0,0" Text="This will permanently delete the local profile and every scan in its history." TextWrapping="Wrap"/>
     <TextBlock Margin="0,16,0,0" Text="This cannot be undone. Exported ZIP copies will remain available separately." TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
   <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,24,0,0">
    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="110"/>
    <Button x:Name="DeleteButton" Content="Delete profile" Click="ConfirmDelete" Background="#A32323" Foreground="White" Margin="0"/>
   </WrapPanel>
  </Grid>
 </Grid>
</Window>
